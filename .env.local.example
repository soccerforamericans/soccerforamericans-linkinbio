# Copy this file to ".env.local" and fill in real values.
# .env.local stays on your machine (it's in .gitignore) - on Vercel you
# enter the same three values in Project Settings > Environment Variables.

# --- Supabase (your click database) ---------------------------------
# From supabase.com: your project > Settings > API
#   "Project URL"        -> SUPABASE_URL
#   "service_role" key   -> SUPABASE_SERVICE_ROLE_KEY  (keep SECRET - it's
#                           an admin password for your database)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stats page password ---------------------------------------------
# Visiting /stats asks for username "admin" + this password.
STATS_PASSWORD=pick-a-good-password-here
